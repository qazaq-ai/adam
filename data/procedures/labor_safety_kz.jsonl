{"id": "kk_okhrana_briefing_004", "title_kk": "Мерзімдік нұсқаулықты жүргізу тәртібі", "title_ru": "Порядок проведения периодического инструктажа", "domain": "okhrana_truda", "applies_to": ["барлық цех қызметкерлері", "инженер-техникалық қызметкерлер"], "prerequisites": ["алдыңғы нұсқаулықтан кейін кемінде 6 ай өтті", "нұсқаулық бағдарламасы бекітілген"], "steps": [{"sequence": 1, "action_kk": "Еңбекті қорғау инженері мерзімдік нұсқаулық кестесін жасайды.", "actor": "еңбекті қорғау инженері", "condition": null, "evidence": "бекітілген кесте"}, {"sequence": 2, "action_kk": "Цех бастығы қызметкерлерге нұсқаулық тақырыбын алдын-ала хабарлайды.", "actor": "цех бастығы", "condition": null, "evidence": "хабарлама журналы"}, {"sequence": 3, "action_kk": "Нұсқаулық кезінде жабдық қауіпсіздігі, авариялық жағдайлар, өрт қауіпсіздігі қарастырылады.", "actor": "еңбекті қорғау инженері", "condition": null, "evidence": "нұсқаулық журналындағы тақырып"}, {"sequence": 4, "action_kk": "Әр қызметкер нұсқаулық журналына қол қояды.", "actor": "қызметкер", "condition": null, "evidence": "журналдағы қолхат"}], "hazards": [{"kind_kk": "қауіп туралы ескіреген білім", "mitigation_kk": "мерзімдік нұсқаулық кемінде 6 ай сайын өткізіледі"}], "authorization": ["еңбекті қорғау инженері", "цех бастығы"], "confirmation_gates": ["барлық қызметкерлердің қол қоюы жиналуы тиіс", "нұсқаулық хаттамасы ресімделуі тиіс"], "source": {"regulation_kk": "Қазақстан Республикасының Еңбек кодексі", "regulation_id": "414-V", "article": "183-бап", "version_date": "2024-04-15", "retrieved_at": "2026-06-22", "url": "https://adilet.zan.kz/kaz/docs/K1500000414"}, "title_en": "Periodic safety briefing procedure", "aliases_kk": ["мерзімдік нұсқаулық", "қайталама нұсқаулық"], "aliases_ru": ["периодический инструктаж", "повторный инструктаж"], "aliases_en": ["periodic briefing", "refresher training"]}
{"id": "kk_construction_height_005", "title_kk": "Биіктікте жұмыс жүргізу тәртібі", "title_ru": "Порядок проведения работ на высоте", "domain": "construction", "applies_to": ["биіктікте жұмыс істейтін қызметкерлер", "құрылыс цехтарының жұмысшылары"], "prerequisites": ["қызметкер биіктікте жұмыс істеуге арналған оқу курсын аяқтаған", "медициналық қарап-тексеру нәтижесі оң"], "steps": [{"sequence": 1, "action_kk": "Бригадир жұмыс орнының биіктігін өлшейді және түрін анықтайды.", "actor": "бригадир", "condition": null, "evidence": "өлшеу актісі"}, {"sequence": 2, "action_kk": "Қызметкер жеке құлдыраудан қорғаныс жүйесін киеді.", "actor": "қызметкер", "condition": "биіктік 1,8 м-ден жоғары", "evidence": "СИЗ беру журналы"}, {"sequence": 3, "action_kk": "Бекіту нүктесі тексеріліп бекітіледі.", "actor": "бригадир", "condition": null, "evidence": "тексеру актісі"}, {"sequence": 4, "action_kk": "Жұмыс барысында бригадир қауіпсіздік ережелерін қадағалайды.", "actor": "бригадир", "condition": null, "evidence": "тексеру журналындағы жазба"}], "hazards": [{"kind_kk": "биіктен құлау", "mitigation_kk": "жеке қорғаныс жүйесі + сенімді бекіту нүктесі"}, {"kind_kk": "заттың құлап түсуі", "mitigation_kk": "төменгі аймақ қоршалуы тиіс"}], "authorization": ["цех бастығы", "бригадир"], "confirmation_gates": ["биіктікте жұмыс жүргізуге наряд-рұқсат ресімделуі тиіс", "СИЗ тексеру актісі бекітілуі тиіс"], "source": {"regulation_kk": "Қазақстан Республикасының Еңбек кодексі", "regulation_id": "414-V", "article": "182-бап", "version_date": "2024-04-15", "retrieved_at": "2026-06-22", "url": "https://adilet.zan.kz/kaz/docs/K1500000414"}, "title_en": "Work-at-height procedure", "aliases_kk": ["биіктікте жұмыс"], "aliases_ru": ["работы на высоте", "верхолазные работы"], "aliases_en": ["work at height", "WAH", "fall protection"]}
{"id": "kk_accident_investigation_006", "title_kk": "Жұмыс орнындағы жазатайым оқиғаны тергеу тәртібі", "title_ru": "Порядок расследования несчастного случая на производстве", "domain": "okhrana_truda", "applies_to": ["барлық кәсіпорын қызметкерлері", "еңбекті қорғау қызметі"], "prerequisites": ["жазатайым оқиға фактісі тіркелді", "жәбірленушіге дереу медициналық көмек көрсетілді"], "steps": [{"sequence": 1, "action_kk": "Тікелей басшы оқиғаны кәсіпорын басшылығына және еңбекті қорғау инженеріне дереу хабарлайды.", "actor": "тікелей басшы", "condition": null, "evidence": "телефондық/жазбаша хабарлама журналы"}, {"sequence": 2, "action_kk": "Кәсіпорын басшылығы тергеу комиссиясын құру туралы бұйрық шығарады.", "actor": "кәсіпорын басшылығы", "condition": null, "evidence": "комиссия құру бұйрығы"}, {"sequence": 3, "action_kk": "Комиссия оқиға орнын қарап-тексереді, куәгерлерден жауап алады, дәлелдемелерді жинайды.", "actor": "тергеу комиссиясы", "condition": "оқиға орны бастапқы күйде сақталған", "evidence": "оқиға орны хаттамасы, куә жауаптары"}, {"sequence": 4, "action_kk": "Комиссия тергеу актісін Н-1 нысаны бойынша 3 күн ішінде ресімдейді.", "actor": "тергеу комиссиясы", "condition": "тергеу аяқталды", "evidence": "Н-1 нысанындағы тергеу актісі"}, {"sequence": 5, "action_kk": "Акт мемлекеттік еңбек инспекциясына жіберіледі.", "actor": "кәсіпорын басшылығы", "condition": null, "evidence": "жіберу журналы"}], "hazards": [{"kind_kk": "дәлелдеме жоғалуы", "mitigation_kk": "оқиға орны медициналық көмек көрсетілгеннен кейін өзгертілмейді"}], "authorization": ["кәсіпорын басшылығы", "еңбекті қорғау инженері", "мемлекеттік еңбек инспекциясы"], "confirmation_gates": ["комиссия құру бұйрығы шығарылуы тиіс", "Н-1 нысанындағы акт 3 күн ішінде ресімделуі тиіс"], "source": {"regulation_kk": "Қазақстан Республикасының Еңбек кодексі", "regulation_id": "414-V", "article": "187-бап", "version_date": "2024-04-15", "retrieved_at": "2026-06-22", "url": "https://adilet.zan.kz/kaz/docs/