{"id": "kk_labor_intro_001", "title_kk": "Жұмысқа алу кезіндегі бастапқы нұсқаулық", "title_ru": "Первичный инструктаж при приёме на работу", "domain": "okhrana_truda", "applies_to": ["барлық жаңа қабылданған қызметкерлер", "өндірістік цехтарға тағайындалған тәжірибешілер"], "prerequisites": ["жұмысқа қабылдау туралы бұйрық шығарылуы тиіс", "медициналық куәлік ұсынылуы тиіс"], "steps": [{"sequence": 1, "action_kk": "Еңбекті қорғау инженері жаңа қызметкермен бастапқы нұсқаулықты жүргізеді.", "actor": "еңбекті қорғау инженері", "condition": null, "evidence": "нұсқаулық журналындағы қол қою"}, {"sequence": 2, "action_kk": "Қызметкер өзіне тиісті жеке қорғаныс құралдарын алады.", "actor": "қызметкер", "condition": "СИЗ нормативі бойынша қаралған позиция", "evidence": "СИЗ беру журналындағы қолхат"}, {"sequence": 3, "action_kk": "Цех бастығы жұмыс орнында арнайы нұсқаулықты жүргізеді.", "actor": "цех бастығы", "condition": null, "evidence": "арнайы нұсқаулық журналындағы қол қою"}], "hazards": [{"kind_kk": "жұмыс орнын білмеуден туындайтын қауіптер", "mitigation_kk": "бекітілген тәлімгер 2 жұмыс күні бойы алып жүреді"}], "authorization": ["еңбекті қорғау инженері", "цех бастығы"], "confirmation_gates": ["нұсқаулық журналдары қол қойылып бекітілуі тиіс", "СИЗ беру актісі ресімделуі тиіс"], "source": {"regulation_kk": "Қазақстан Республикасының Еңбек кодексі", "regulation_id": "414-V", "article": "183-бап", "version_date": "2024-04-15", "retrieved_at": "2026-06-22", "url": "https://adilet.zan.kz/kaz/docs/K1500000414"}, "title_en": "Initial safety briefing upon hiring", "aliases_kk": ["бастапқы нұсқаулық", "жұмысқа қабылдау нұсқаулығы", "алғаш келген қызметкер", "жаңа жұмысшы", "жұмысқа алғаш келген", "жаңа қабылданған қызметкер"], "aliases_ru": ["вводный инструктаж", "первичный инструктаж", "инструктаж при приёме"], "aliases_en": ["initial briefing", "induction training", "onboarding safety"]}
{"id": "kk_labor_ppe_002", "title_kk": "Жеке қорғаныс құралдарын беру тәртібі", "title_ru": "Порядок выдачи средств индивидуальной защиты", "domain": "okhrana_truda", "applies_to": ["зиянды немесе қауіпті өндірістік факторларға ұшырайтын қызметкерлер"], "prerequisites": ["қызметкер аттестациядан өткен лауазымда жұмыс істейді", "бекітілген СИЗ нормативі бар"], "steps": [{"sequence": 1, "action_kk": "Кадр бөлімі қызметкердің лауазымы бойынша СИЗ нормативін анықтайды.", "actor": "кадр бөлімі", "condition": null, "evidence": "СИЗ нормасы бар тізім"}, {"sequence": 2, "action_kk": "Қойма меңгерушісі тиісті өлшемдегі СИЗ-ді дайындайды.", "actor": "қойма меңгерушісі", "condition": "СИЗ қоймада қолжетімді", "evidence": "қойма құжаты"}, {"sequence": 3, "action_kk": "Қызметкер СИЗ-ді алып, журналға қол қояды.", "actor": "қызметкер", "condition": null, "evidence": "СИЗ беру журналындағы қолхат"}], "hazards": [{"kind_kk": "СИЗ-сіз жұмыс істеу", "mitigation_kk": "бұл рәсім аяқталмайынша қызметкер цехқа кіргізілмейді"}], "authorization": ["кадр бөлімі", "қойма меңгерушісі"], "confirmation_gates": ["СИЗ беру журналы қол қойылуы тиіс"], "source": {"regulation_kk": "Қазақстан Республикасының Еңбек кодексі", "regulation_id": "414-V", "article": "182-бап", "version_date": "2024-04-15", "retrieved_at": "2026-06-22", "url": "https://adilet.zan.kz/kaz/docs/K1500000414"}, "title_en": "PPE issuance procedure", "aliases_kk": ["ЕҚҚ", "жеке қорғаныс құралдары", "арнайы киім"], "aliases_ru": ["СИЗ", "средства индивидуальной защиты", "спецодежда"], "aliases_en": ["PPE", "personal protective equipment", "safety gear"]}
{"id": "kk_metallurgy_loto_003", "title_kk": "Жабдықты сөндіру және блоктау тәртібі", "title_ru": "Порядок отключения и блокировки оборудования (LOTO)", "domain": "metallurgy", "applies_to": ["жөндеу жұмыстарын орындайтын қызметкерлер", "техникалық қызмет көрсету тобы"], "prerequisites": ["жөндеуге жұмыс наряд-рұқсаты ресімделген", "жабдық жұмыс журналында тоқтату туралы жазба бар"], "steps": [{"sequence": 1, "action_kk": "Энергетик электр қуатын ажыратады және коммутациялық аппаратты блоктайды.", "actor": "энергетик", "condition": null, "evidence": "электр блоктау бирка"}, {"sequence": 2, "action_kk": "Механик гидравликалық және пневматикалық жүйелерді босатады.", "actor": "механик", "condition": "қысым көрсеткіші 0-ге жетті", "evidence": "қысым нөлдік белгідегі сурет"}, {"sequence": 3, "action_kk": "Бригадир жұмыс орнында «жұмыс жүріп жатыр» белгісін орнатады.", "actor": "бригадир", "condition": null, "evidence": "белгінің фотосы"}, {"sequence": 4, "action_kk": "Жөндеу аяқталғаннан кейін кері тәртіппен блокировкалар алынады.", "actor": "энергетик", "condition": "жөндеу актісі қол қойылған", "evidence": "актіге бекітілген қолхат"}], "hazards": [{"kind_kk": "күтпеген іске қосылу", "mitigation_kk": "коммутациялық аппаратты механикалық блоктау + жеке құлып"}, {"kind_kk": "қалдық қысым шығарылуы", "mitigation_kk": "қысым көрсеткіші тексерілмейінше жұмыс басталмайды"}], "authorization": ["цех бастығы", "энергетик", "механик"], "confirmation_gates": ["жөндеу наряд-рұқсаты қол қойылуы тиіс", "барлық блоктаулар тізілімге енгізілуі тиіс", "жөндеу аяқталу актісі ресімделуі тиіс"], "source": {"regulation_kk": "Қауіпсіздік стандарттарының жүйесі — жабдықпен жұмыс істеу кезіндегі қауіпсіздік", "regulation_id": "ГОСТ 12.2.003-91", "article": "5-бөлім", "version_date": "1991-01-01", "retrieved_at": "2026-06-22", "url": null}, "title_en": "Lockout/tagout (LOTO) procedure", "aliases_kk": ["жабдықты блоктау", "сөндіру тәртібі"], "aliases_ru": ["LOTO", "лок-аут таг-аут", "блокировка 